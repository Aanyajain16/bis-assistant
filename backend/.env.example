# Copy this file to .env and fill in real values. Never commit .env itself.

# --- LLM provider (used later by the answer-generation stage, not by ingestion) ---
LLM_API_KEY=your_api_key_here
LLM_PROVIDER=anthropic

# --- RAG / ingestion settings (all optional — sensible defaults are built in) ---
BIS_DOCS_DIR=data/bis_documents
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION_NAME=bis_documents
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHUNK_SIZE_WORDS=220
CHUNK_OVERLAP_WORDS=40
